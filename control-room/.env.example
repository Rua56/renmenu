# ESEMPIO DOCUMENTALE: non copiare in una variabile client o nel repository valori reali.
# Staging privato Pages separato da renmenu.pages.dev. Default: nessuna azione esterna.
ENVIRONMENT=protected-staging
STAGING_PROTECTED=false
OWNER_EMAIL=renmenu1569@gmail.com
TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
POLICY_AUD=YOUR_STABLE_PAGES_ACCESS_AUDIENCE
PREVIEW_AUD=YOUR_WILDCARD_DEPLOYMENT_ACCESS_AUDIENCE

# Pages Bindings, NON stringhe client-side:
# DB -> D1 dedicato renmenu-jarvis-stage, migrazioni 0001, 0002 e 0003.
# BUCKET -> bucket R2 privato renmenu-jarvis-stage-private (senza dominio pubblico).
# AI -> Workers AI binding (solo AI_PROVIDER=cloudflare_workers_ai; nessuna chiave).
D1_DATABASE_ID=
R2_BUCKET=

# AI: mock, cloudflare_workers_ai (Workers Free: hard stop 10.000 Neurons/giorno),
# oppure openai_compatible (richiede chiave e disponibilita del provider).
AI_PROVIDER=mock
AI_API_BASE=
# Cloudflare richiede AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast;
# ogni altro modello e' rifiutato prima dell'inferenza.
# Con Cloudflare, AI_API_BASE e AI_API_KEY rimangono inutilizzati; non attiva OCR/audio.
AI_MODEL=
AI_API_KEY=
AI_TRANSCRIBE_MODEL=
# In tutte le modalita live, solo questa pratica fittizia puo essere inviata al provider.
# La stessa pratica deve avere is_ai_test_fixture=1 e SHA-256 approvati in D1.
# ENVIRONMENT=protected-staging + STAGING_PROTECTED=true sono obbligatori.
# Solo classificazione/estrazione del testo sigillato, max 3 tentativi/azione/giorno UTC;
# traduzioni con input arbitrario, OCR e audio live restano disabilitati.
AI_TEST_REQUEST_ID=

# GitHub: mock oppure live, token solo su Secret Pages e solo per Rua56/renmenu.
GITHUB_PROVIDER=mock
GITHUB_TOKEN=
GITHUB_OWNER=Rua56
GITHUB_REPO=renmenu

# Relay Gmail del SOLO account business, disattivato fino al cutover dal vecchio Jarvis.
GMAIL_RELAY_ENABLED=false
GMAIL_RELAY_SECRET=

# Email proprietario via account Resend RenMenu. Destinatario fissato nel codice.
EMAIL_LIVE_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_VERIFIED=false
RESEND_ONBOARDING_SENDER_AUTHORIZED=false

# WhatsApp webhook firmato, provider outgoing opzionale e spento.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Chiamate/SMS non implementati: stub fail-closed. Nessun numero o token necessario.
CALL_PROVIDER=mock
CALL_PROVIDER_TOKEN=
OWNER_PHONE=

# Non includere qui email clienti, allegati, password, access token, IBAN o chiavi vere.
# Preview/Production Pages richiedono Access e binding separati; lasciare i flag off fino al collaudo.
