# ESEMPIO DOCUMENTALE. Non caricare automaticamente, non committare valori veri.
# In questa PR nessuna integrazione live viene abilitata impostando queste variabili.
APP_ENV=demo
TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
POLICY_AUD=YOUR_ACCESS_APPLICATION_AUDIENCE_TAG
OWNER_EMAIL=owner@example.com
# Binding Pages da associare a risorse NUOVE e DEDICATE:
# DB -> Cloudflare D1 (D1_DATABASE_ID solo configurazione deploy, non codice frontend)
# BUCKET -> Cloudflare R2 privato (R2_BUCKET solo configurazione deploy)
D1_DATABASE_ID=
R2_BUCKET=

# FUTURO, NON SUPPORTATO DAGLI ADAPTER DI QUESTA PR: modalità non-mock ritorna HTTP 501.
GITHUB_PROVIDER=mock
GITHUB_OWNER=Rua56
GITHUB_REPO=renmenu
GITHUB_TOKEN=
AI_PROVIDER=mock
AI_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CALL_PROVIDER=mock
CALL_PROVIDER_TOKEN=
OWNER_PHONE=

# Mai inserire qui token Gmail, Resend/Twilio/Stripe, dati cliente o IBAN.
# Tenere Preview e Production con variabili/binding separati nel pannello Cloudflare Pages.
